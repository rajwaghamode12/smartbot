# ==============================================================================
# SmartBot — AI Chatbot Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to ".env"
# 2. Replace "your_openai_api_key_here" with your valid OpenAI API key from https://platform.openai.com/api-keys
# 3. Adjust the model name or server port if needed.
# ==============================================================================

# Required: Your OpenAI API Secret Key (Keep this secret! Never commit .env to Git)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model to use (Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, o3-mini)
# Default is gpt-4o-mini (fastest, most cost-effective, and highly intelligent)
OPENAI_MODEL=gpt-4o-mini

# Server Port (Default is 5000)
PORT=5000

# Flask Environment (Set to False in production)
FLASK_DEBUG=True

# Application Host (127.0.0.1 for local access only, 0.0.0.0 to allow LAN access)
HOST=127.0.0.1

# Optional: System Instruction to shape SmartBot's personality and expertise
SYSTEM_INSTRUCTIONS=You are SmartBot, a friendly, intelligent, and highly knowledgeable AI assistant. You excel at computer science, programming (Python, JavaScript, Web Dev, etc.), academic tutoring, project architecture, and explaining complex concepts clearly with step-by-step reasoning. Format your responses with clean Markdown, lists, and syntax-highlighted code blocks where appropriate.
